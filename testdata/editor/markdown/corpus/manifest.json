    { "file": "support/links.md", "expect": "identical", "note": "内联链接（含 title、URL 带中文参数）" },
    { "file": "support/list-unordered.md", "expect": "identical", "note": "无序列表（- 标记）" },
    { "file": "support/list-ordered.md", "expect": "identical", "note": "有序列表（1. 标记）" },
    { "file": "support/task-list.md", "expect": "identical", "note": "任务列表（未完成/已完成）" },
    { "file": "support/blockquote.md", "expect": "identical", "note": "引用与嵌套引用" },
    { "file": "support/horizontal-rule.md", "expect": "identical", "note": "分隔线" },
    { "file": "support/nested-mixed.md", "expect": "identical", "note": "嵌套标记：列表内粗体/代码/嵌套列表、引用内列表" },
