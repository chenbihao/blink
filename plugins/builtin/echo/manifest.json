{
  "schema_version": 1,
  "id": "builtin.echo",
  "name": "Echo",
  "version": "0.1.0",
  "description": "调试用插件，回显输入内容，验证上下文快照链路",
  "builtin": true,
  "runtime": {
    "type": "process",
    "protocol": "jsonl",
    "exec": "./bin/blink-plugin-echo.exe",
    "timeout_ms": 2000,
    "concurrency": 1
  },
  "triggers": [
    { "type": "keyword", "keyword": "echo", "exclusive": true }
  ],
  "capabilities": ["query"]
}
