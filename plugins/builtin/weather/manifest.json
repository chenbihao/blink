{
  "schema_version": 1,
  "id": "builtin.weather",
  "name": { "zh": "天气", "en": "Weather" },
  "version": "0.1.0",
  "description": { "zh": "查询城市天气（open-meteo，免费无需 key）", "en": "City weather (open-meteo, free, no key needed)" },
  "builtin": true,
  "runtime": {
    "type": "process",
    "protocol": "jsonl",
    "exec": "./bin/blink-plugin-weather.exe",
    "timeout_ms": 5000,
    "min_arg_length": 2,
    "debounce_ms": 500,
    "concurrency": 1
  },
  "triggers": [
    { "type": "keyword", "keyword": "天气", "exclusive": true },
    { "type": "keyword", "keyword": "weather", "exclusive": true }
  ],
  "capabilities": ["query"],
  "tools": [
    {
      "name": "get_weather",
      "description": "查询指定城市的当前天气，包括温度、天气状况和风速。数据来自 open-meteo（免费无需 API key）。不传 city 时用配置的默认城市。",
      "parameters": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "description": "城市名称（中文或英文），如「北京」「Tokyo」「New York」。不传时用配置的默认城市"
          },
          "unit": {
            "type": "string",
            "description": "温度单位",
            "enum": ["celsius", "fahrenheit"],
            "default": "celsius"
          }
        }
      },
      "danger_class": "Safe",
      "result_type": "text",
      "hint": "返回城市名、温度、天气状况、风速等结构化数据，AI 可据此总结提醒（如带伞）",
      "progress_hint": "查询天气",
      "setting_bindings": {
        "city": "default_city",
        "unit": "temperature_unit"
      },
      "projection": {
        "result_shape": "text",
        "pointer": "$.temp",
        "desc_pointer": "$.city"
      }
    }
  ],
  "settings_schema": [
    {
      "key": "default_city",
      "type": "string",
      "title": { "zh": "默认城市", "en": "Default city" },
      "description": { "zh": "无参数时查询的城市（如「北京」）", "en": "City queried with no argument (e.g. 'Beijing')" },
      "default": ""
    },
    {
      "key": "temperature_unit",
      "type": "enum",
      "title": { "zh": "温度单位", "en": "Temperature unit" },
      "default": "celsius",
      "options": [
        { "value": "celsius", "label": { "zh": "摄氏度 (°C)", "en": "Celsius (°C)" } },
        { "value": "fahrenheit", "label": { "zh": "华氏度 (°F)", "en": "Fahrenheit (°F)" } }
      ]
    }
  ]
}
