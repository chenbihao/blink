{
  "schema_version": 1,
  "id": "builtin.translate",
  "name": "翻译",
  "version": "0.2.0",
  "description": "多引擎文本翻译：腾讯翻译/阿里翻译/百度翻译/有道智云/DeepL",
  "builtin": true,
  "runtime": {
    "type": "python",
    "protocol": "jsonl",
    "exec": "./main.py",
    "timeout_ms": 10000,
    "min_arg_length": 0,
    "debounce_ms": 500,
    "concurrency": 1
  },
  "triggers": [
    { "type": "keyword", "keyword": "fy", "exclusive": true },
    { "type": "keyword", "keyword": "翻译", "exclusive": true }
  ],
  "capabilities": ["query"],
  "settings_schema": [
    {
      "key": "default_engine",
      "type": "enum",
      "title": "默认翻译引擎",
      "options": [
        { "value": "tencent", "label": "腾讯翻译" },
        { "value": "ali", "label": "阿里翻译" },
        { "value": "baidu", "label": "百度翻译" },
        { "value": "youdao", "label": "有道智云" },
        { "value": "deepl", "label": "DeepL" }
      ],
      "default": "tencent"
    },
    {
      "key": "fallback_order",
      "type": "sortable_list",
      "title": "降级顺序",
      "description": "主引擎失败时按此顺序尝试，拖动调整顺序",
      "options": [
        { "value": "tencent", "label": "腾讯翻译" },
        { "value": "ali", "label": "阿里翻译" },
        { "value": "baidu", "label": "百度翻译" },
        { "value": "youdao", "label": "有道智云" },
        { "value": "deepl", "label": "DeepL" }
      ],
      "default": ["tencent", "ali", "baidu", "youdao", "deepl"]
    },
    {
      "key": "target_lang",
      "type": "enum",
      "title": "目标语言",
      "options": [
        { "value": "auto", "label": "自动检测" },
        { "value": "zh", "label": "中文" },
        { "value": "en", "label": "英文" },
        { "value": "ja", "label": "日文" },
        { "value": "ko", "label": "韩文" }
      ],
      "default": "zh"
    },
    {
      "key": "tencent_secret_id",
      "type": "string",
      "title": "SecretId",
      "group": {
        "title": "腾讯云机器翻译",
        "description": "申请地址（每月免费额度）: https://cloud.tencent.com/product/tmt"
      }
    },
    {
      "key": "tencent_secret_key",
      "type": "string",
      "title": "SecretKey",
      "group": "腾讯云机器翻译",
      "secret": true
    },
    {
      "key": "ali_access_key_id",
      "type": "string",
      "title": "AccessKey ID",
      "group": {
        "title": "阿里机器翻译",
        "description": "申请地址（每月免费额度）: https://www.aliyun.com/product/ai/base_alimt"
      }
    },
    {
      "key": "ali_access_key_secret",
      "type": "string",
      "title": "AccessKey Secret",
      "group": "阿里机器翻译",
      "secret": true
    },
    {
      "key": "baidu_app_id",
      "type": "string",
      "title": "APP ID",
      "group": {
        "title": "百度翻译",
        "description": "申请地址（每月免费额度）: https://fanyi-api.baidu.com/"
      }
    },
    {
      "key": "baidu_app_key",
      "type": "string",
      "title": "密钥 (APP Key)",
      "group": "百度翻译",
      "secret": true
    },
    {
      "key": "youdao_app_key",
      "type": "string",
      "title": "应用ID (appKey)",
      "group": {
        "title": "有道智云",
        "description": "申请地址（体验金）: https://ai.youdao.com/"
      }
    },
    {
      "key": "youdao_app_secret",
      "type": "string",
      "title": "应用密钥 (appSecret)",
      "group": "有道智云",
      "secret": true
    },
    {
      "key": "deepl_api_key",
      "type": "string",
      "title": "DeepL API Key",
      "group": {
        "title": "DeepL",
        "description": "申请地址: https://www.deepl.com/pro-api"
      },
      "secret": true
    }
  ]
}
