{
  "schema_version": 1,
  "id": "builtin.translate",
  "name": { "zh": "翻译", "en": "Translate" },
  "version": "0.3.0",
  "description": { "zh": "多引擎文本翻译：腾讯翻译/阿里翻译/百度翻译/有道智云/DeepL", "en": "Multi-engine translation: Tencent / Alibaba / Baidu / Youdao / DeepL" },
  "builtin": true,
  "default_enabled": false,
  "runtime": {
    "type": "process",
    "protocol": "jsonl",
    "exec": "./bin/blink-plugin-translate.exe",
    "timeout_ms": 10000,
    "min_arg_length": 0,
    "debounce_ms": 500,
    "concurrency": 1,
    "empty_arg_hint": {
      "zh": "输入文本开始翻译",
      "en": "Type text to translate"
    }
  },
  "triggers": [
    { "type": "keyword", "keyword": "翻译", "exclusive": true },
    { "type": "keyword", "keyword": "translate", "exclusive": true },
    { "type": "context", "when": "text_is_non_target_lang", "surface": "priority" }
  ],
  "capabilities": ["query"],
  "tools": [
    {
      "name": "translate",
      "description": "翻译文本到目标语言。支持中英日韩等多语言互译。",
      "parameters": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "description": "要翻译的文本" },
          "target_lang": {
            "type": "string",
            "description": "目标语言代码",
            "enum": ["zh", "en", "ja", "ko"],
            "default": "zh"
          }
        },
        "required": ["text"]
      },
      "danger_class": "Safe",
      "result_type": "text",
      "hint": "返回译文字符串，AI 直接使用",
      "progress_hint": "翻译文本",
      "setting_bindings": {
        "target_lang": "target_lang"
      },
      "projection": {
        "result_shape": "text",
        "pointer": "$",
        "desc": "译文"
      }
    },
    {
      "name": "translate_batch",
      "description": "批量翻译多行文本并保持输入顺序。供截图图上翻译等内部链路使用。",
      "parameters": {
        "type": "object",
        "properties": {
          "texts": {
            "type": "array",
            "description": "要翻译的非空文本数组",
            "items": { "type": "string" }
          },
          "target_lang": {
            "type": "string",
            "description": "目标语言代码",
            "enum": ["zh", "en", "ja", "ko"],
            "default": "zh"
          }
        },
        "required": ["texts"]
      },
      "danger_class": "Safe",
      "result_type": "items",
      "hint": "返回译文数组，顺序与 texts 一一对应",
      "progress_hint": "批量翻译文本",
      "setting_bindings": {
        "target_lang": "target_lang"
      },
      "projection": {
        "result_shape": "items",
        "items_pointer": "$",
        "item_actions": [{"type": "copy"}]
      }
    }
  ],
  "settings_schema": [
    {
      "key": "target_lang",
      "type": "enum",
      "title": { "zh": "目标语言", "en": "Target language" },
      "options": [
        { "value": "auto", "label": { "zh": "自动检测", "en": "Auto-detect" } },
        { "value": "zh", "label": { "zh": "中文", "en": "Chinese" } },
        { "value": "en", "label": { "zh": "英文", "en": "English" } },
        { "value": "ja", "label": { "zh": "日文", "en": "Japanese" } },
        { "value": "ko", "label": { "zh": "韩文", "en": "Korean" } }
      ],
      "default": "zh"
    },
    {
      "key": "default_engine",
      "type": "enum",
      "title": { "zh": "默认翻译引擎", "en": "Default engine" },
      "options": [
        { "value": "tencent", "label": { "zh": "腾讯翻译", "en": "Tencent" } },
        { "value": "ali", "label": { "zh": "阿里翻译", "en": "Alibaba" } },
        { "value": "baidu", "label": { "zh": "百度翻译", "en": "Baidu" } },
        { "value": "youdao", "label": { "zh": "有道智云", "en": "Youdao" } },
        { "value": "deepl", "label": "DeepL" }
      ],
      "default": "tencent"
    },
    {
      "key": "fallback_order",
      "type": "sortable_list",
      "title": { "zh": "降级顺序", "en": "Fallback order" },
      "description": { "zh": "主引擎失败时按此顺序尝试，拖动调整顺序", "en": "Tried in this order when the main engine fails; drag to reorder" },
      "options": [
        { "value": "tencent", "label": { "zh": "腾讯翻译", "en": "Tencent" } },
        { "value": "ali", "label": { "zh": "阿里翻译", "en": "Alibaba" } },
        { "value": "baidu", "label": { "zh": "百度翻译", "en": "Baidu" } },
        { "value": "youdao", "label": { "zh": "有道智云", "en": "Youdao" } },
        { "value": "deepl", "label": "DeepL" }
      ],
      "default": ["tencent", "ali", "baidu", "youdao", "deepl"]
    },
    {
      "key": "tencent_secret_id",
      "type": "string",
      "title": "SecretId",
      "group": {
        "title": "腾讯云机器翻译",
        "description": "申请地址（每月免费额度）: https://cloud.tencent.com/product/tmt"
      }
    },
    {
      "key": "tencent_secret_key",
      "type": "string",
      "title": "SecretKey",
      "group": "腾讯云机器翻译",
      "secret": true
    },
    {
      "key": "ali_access_key_id",
      "type": "string",
      "title": "AccessKey ID",
      "group": {
        "title": "阿里机器翻译",
        "description": "申请地址（每月免费额度）: https://www.aliyun.com/product/ai/base_alimt"
      }
    },
    {
      "key": "ali_access_key_secret",
      "type": "string",
      "title": "AccessKey Secret",
      "group": "阿里机器翻译",
      "secret": true
    },
    {
      "key": "baidu_app_id",
      "type": "string",
      "title": "APP ID",
      "group": {
        "title": "百度翻译",
        "description": "申请地址（每月免费额度）: https://fanyi-api.baidu.com/"
      }
    },
    {
      "key": "baidu_app_key",
      "type": "string",
      "title": "密钥 (APP Key)",
      "group": "百度翻译",
      "secret": true
    },
    {
      "key": "youdao_app_key",
      "type": "string",
      "title": "应用ID (appKey)",
      "group": {
        "title": "有道智云",
        "description": "申请地址（体验金）: https://ai.youdao.com/"
      }
    },
    {
      "key": "youdao_app_secret",
      "type": "string",
      "title": "应用密钥 (appSecret)",
      "group": "有道智云",
      "secret": true
    },
    {
      "key": "deepl_api_key",
      "type": "string",
      "title": "DeepL API Key",
      "group": {
        "title": "DeepL",
        "description": "申请地址: https://www.deepl.com/pro-api"
      },
      "secret": true
    }
  ]
}
