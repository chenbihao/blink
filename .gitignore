# Plugins
# Rust 插件构建输出（release 打包时临时生成，开发期不存在）
plugins/builtin/*/bin/

# PP-OCRv6 spike — 不提交 venv、模型、缓存、下载产物或 benchmark 临时输出
xtask/spikes/ppocrv6/.venv/
xtask/spikes/ppocrv6/uv-cache/
xtask/spikes/ppocrv6/model-cache/
xtask/spikes/ppocrv6/results/
xtask/spikes/ppocrv6/*.png.bak

# FunASR llama.cpp/GGUF spike runtime, models, generated fixtures and raw results
xtask/spikes/funasr-runtime/.cache/
xtask/spikes/funasr-runtime/results/
xtask/spikes/funasr-runtime/tmp/
testdata/stt/funasr-runtime/generated/

# ONNX spike — standalone Cargo outputs, downloaded runtimes/models and transient worker state
xtask/spikes/**/target/
xtask/spikes/onnx-spike/followup/runtimes/
xtask/spikes/onnx-spike/followup/spike-*/results/
xtask/spikes/onnx-spike/followup/worker_started.marker
xtask/spikes/onnx-spike/models/.lock/
xtask/spikes/onnx-spike/models/models/
xtask/spikes/onnx-spike/models/paraformer-online-onnx/
xtask/spikes/onnx-spike/models/ppocrv6-onnx/
xtask/spikes/onnx-spike/models/sherpa-paraformer-online/
xtask/spikes/onnx-spike/models/sherpa-paraformer-online.tar.bz2
xtask/spikes/onnx-spike/models/asr_example.wav

# 0.22.7 GGUF worker 构建产物（由 cargo xtask funasr-worker 生成，不入 Git；
# 来源锁定见 resources/stt/funasr-gguf/worker-lock.json）
resources/bin/
# 模型下载缓存（安装期校验用临时文件）
target/gguf-models/

# STT Gate Corpus — 真实用户录音，隐私铁则禁止提交
# 录音只保存在用户明确指定的本地目录，不上传、不进 Git、不复制到发布资源
corpus/
testdata/stt/corpus/
*.corpus.wav
# manifest.json 可提交（只含标注，不含音频），但 corpus 根目录整体排除
# 如需提交 manifest，显式 git add -f corpus/manifest.json
