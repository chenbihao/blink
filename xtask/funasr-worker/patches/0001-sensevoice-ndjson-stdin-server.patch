+#ifndef BLINK_BACKEND_ADAPTER_H
+#define BLINK_BACKEND_ADAPTER_H
+
+// Shared, deliberately narrow ggml backend adapter for all Blink FunASR
+// workers.  This header never invokes the registry-wide backend discovery
+// helpers, because they may consume process-global search paths.  Dynamic
+// backends are loaded only by the exact path supplied through --backend-dir.
+
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+#include "ggml.h"
+#include "blink_worker_protocol.h"
+
+#include <algorithm>
+#include <cctype>
+#include <filesystem>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace blink_backend {
+
+struct Error : std::runtime_error {
+    std::string code;
+
+    Error(std::string code_, std::string message)
+        : std::runtime_error(std::move(message)), code(std::move(code_)) {}
+};
+
+struct CliOptions {
+    std::string requested_backend = "cpu";
+    std::string backend_dir;
+    bool probe = false;
+};
+
+inline std::string lower(std::string value) {
+    std::transform(value.begin(), value.end(), value.begin(), [](unsigned char c) {
+        return static_cast<char>(std::tolower(c));
+    });
+    return value;
+}
+
+inline bool parse_cli(int argc, char ** argv, CliOptions & out, std::string & error) {
+    for (int i = 1; i < argc; ++i) {
+        const std::string arg = argv[i];
+        if (arg == "--backend") {
+            if (i + 1 >= argc) {
+                error = "--backend requires cpu, vulkan, or cuda";
+                return false;
+            }
+            out.requested_backend = lower(argv[++i]);
+            if (out.requested_backend != "cpu" && out.requested_backend != "vulkan" &&
+                out.requested_backend != "cuda") {
+                error = "unsupported backend '" + out.requested_backend + "' (expected cpu|vulkan|cuda)";
+                return false;
+            }
+        } else if (arg == "--backend-dir") {
+            if (i + 1 >= argc) {
+                error = "--backend-dir requires a deployment directory";
+                return false;
+            }
+            out.backend_dir = argv[++i];
+            if (out.backend_dir.empty()) {
+                error = "--backend-dir must not be empty";
+                return false;
+            }
+        } else if (arg == "--blink-backend-probe") {
+            out.probe = true;
+        }
+    }
+    return true;
+}
+
+inline std::string backend_filename(const std::string & backend) {
+    // 0.22.16.3 publishes these exact names in --backend-dir.  The base
+    // artifact contains ggml-cpu; Vulkan and CUDA are optional additions.
+#if defined(_WIN32)
+    return "ggml-" + backend + ".dll";
+#else
+    return "libggml-" + backend + ".so";
+#endif
+}
+
+inline ggml_backend_reg_t find_registry_backend(const std::string & name) {
+    return ggml_backend_reg_by_name(name.c_str());
+}
+
+inline ggml_backend_dev_t find_device(const std::string & requested) {
+    if (requested == "cpu") {
+        return ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    }
+
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        ggml_backend_dev_t device = ggml_backend_dev_get(i);
+        const ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(device);
+        const std::string reg_name = reg ? lower(ggml_backend_reg_name(reg)) : std::string();
+        const std::string device_name = lower(ggml_backend_dev_name(device));
+        const std::string description = lower(ggml_backend_dev_description(device));
+        if (reg_name == requested || device_name.find(requested) != std::string::npos ||
+            description.find(requested) != std::string::npos) {
+            return device;
+        }
+    }
+    return nullptr;
+}
+
+inline void load_dynamic_backend(const std::string & requested, const std::string & backend_dir) {
+    if (backend_dir.empty()) {
+        throw Error("backend_dir_required",
+                    "backend '" + requested + "' requires --backend-dir");
+    }
+
+    std::error_code ec;
+    const std::filesystem::path root = std::filesystem::weakly_canonical(
+        std::filesystem::path(backend_dir), ec);
+    if (ec || !std::filesystem::is_directory(root, ec) || ec) {
+        throw Error("backend_dir_invalid", "backend deployment directory is not usable");
+    }
+
+    const std::filesystem::path library = root / backend_filename(requested);
+    if (!std::filesystem::is_regular_file(library, ec) || ec) {
+        throw Error("backend_library_missing",
+                    "missing backend library '" + backend_filename(requested) + "'");
+    }
+
+    // Do not replace this with the registry-wide directory loader: the pinned
+    // ggml commit also consults process-global search paths there.
+    if (!find_registry_backend(requested)) {
+        if (!ggml_backend_load(library.u8string().c_str())) {
+            throw Error("backend_load_failed",
+                        "failed to load backend library '" + backend_filename(requested) + "'");
+        }
+    }
+}
+
+class Session {
+public:
+    explicit Session(const CliOptions & options) {
+        metadata_.requested_backend = options.requested_backend;
+
+        if (options.requested_backend == "cpu") {
+#if defined(GGML_BACKEND_DL)
+            load_dynamic_backend("cpu", options.backend_dir);
+#endif
+            device_ = find_device("cpu");
+            if (!device_) {
+                throw Error("backend_device_missing", "CPU backend did not register a device");
+            }
+            backend_ = ggml_backend_dev_init(device_, nullptr);
+            buffer_type_ = ggml_backend_dev_buffer_type(device_);
+        } else {
+#if defined(GGML_BACKEND_DL)
+            load_dynamic_backend(options.requested_backend, options.backend_dir);
+#else
+            const ggml_backend_reg_t reg = find_registry_backend(options.requested_backend);
+            if (!reg) {
+                throw Error("backend_not_built",
+                            "backend '" + options.requested_backend + "' is not built");
+            }
+#endif
+            device_ = find_device(options.requested_backend);
+            if (!device_) {
+                throw Error("backend_device_missing",
+                            "backend '" + options.requested_backend + "' has no compatible device");
+            }
+            backend_ = ggml_backend_dev_init(device_, nullptr);
+            buffer_type_ = ggml_backend_dev_buffer_type(device_);
+        }
+
+        if (!backend_) {
+            throw Error("backend_init_failed",
+                        "failed to initialize backend '" + options.requested_backend + "'");
+        }
+        if (!buffer_type_) {
+            ggml_backend_free(backend_);
+            backend_ = nullptr;
+            throw Error("backend_buffer_type_missing",
+                        "backend '" + options.requested_backend + "' has no buffer type");
+        }
+
+        metadata_.actual_backend = options.requested_backend;
+        if (device_) {
+            const ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(device_);
+            const std::string actual = reg ? lower(ggml_backend_reg_name(reg)) : std::string();
+            if (!actual.empty() && actual != options.requested_backend) {
+                ggml_backend_free(backend_);
+                backend_ = nullptr;
+                throw Error("backend_device_mismatch",
+                            "requested backend '" + options.requested_backend +
+                                "' selected device from backend '" + actual + "'");
+            }
+            metadata_.actual_backend = actual.empty() ? options.requested_backend : actual;
+        }
+        const char * buffer_name = ggml_backend_buft_name(buffer_type_);
+        metadata_.buffer_type = buffer_name ? buffer_name : "unknown";
+        if (device_) {
+            ggml_backend_dev_props props{};
+            ggml_backend_dev_get_props(device_, &props);
+            metadata_.device_name = props.name && *props.name ? props.name : ggml_backend_dev_name(device_);
+            metadata_.device_id = props.device_id && *props.device_id ? props.device_id : "unknown";
+        } else {
+            metadata_.device_name = "CPU";
+            metadata_.device_id = "cpu";
+        }
+        if (metadata_.device_name.empty()) metadata_.device_name = "unknown";
+        if (metadata_.device_id.empty()) metadata_.device_id = "unknown";
+    }
+
+    Session(const Session &) = delete;
+    Session & operator=(const Session &) = delete;
+
+    ~Session() {
+        if (backend_) ggml_backend_free(backend_);
+    }
+
+    const blink_worker::BackendMetadata & metadata() const { return metadata_; }
+    ggml_backend_t backend() const { return backend_; }
+    ggml_backend_dev_t device() const { return device_; }
+    ggml_backend_buffer_type_t buffer_type() const { return buffer_type_; }
+
+    void set_input(ggml_tensor * tensor, const void * data, size_t size) const {
+        ggml_backend_tensor_set(tensor, data, 0, size);
+    }
+
+    void get_output(const ggml_tensor * tensor, void * data, size_t size) const {
+        ggml_backend_tensor_get(tensor, data, 0, size);
+    }
+
+    ggml_gallocr_t allocate_graph(ggml_cgraph * graph) const {
+        ggml_gallocr_t allocator = ggml_gallocr_new(buffer_type_);
+        if (!allocator || !ggml_gallocr_alloc_graph(allocator, graph)) {
+            if (allocator) ggml_gallocr_free(allocator);
+            throw Error("backend_graph_alloc_failed",
+                        "backend could not allocate the graph on '" + metadata_.actual_backend + "'");
+        }
+        return allocator;
+    }
+
+    void validate_graph(const ggml_cgraph * graph) const {
+        for (int i = 0; i < graph->n_nodes; ++i) {
+            const ggml_tensor * node = graph->nodes[i];
+            if (!ggml_backend_dev_supports_op(device_, node)) {
+                throw Error("backend_unsupported_op",
+                            "backend '" + metadata_.actual_backend + "' does not support graph op '" +
+                                std::string(ggml_op_name(node->op)) + "'");
+            }
+        }
+    }
+
+    void compute(ggml_cgraph * graph) const {
+        const enum ggml_status status = ggml_backend_graph_compute(backend_, graph);
+        if (status != GGML_STATUS_SUCCESS) {
+            throw Error("backend_graph_compute_failed",
+                        "backend graph compute failed with status " + std::to_string(static_cast<int>(status)));
+        }
+        ggml_backend_synchronize(backend_);
+    }
+
+    void set_cpu_threads(int n_threads) const {
+#if defined(GGML_USE_CPU) && !defined(GGML_BACKEND_DL)
+        if (metadata_.actual_backend == "cpu") ggml_backend_cpu_set_n_threads(backend_, n_threads);
+#else
+        (void)n_threads;
+#endif
+    }
+
+private:
+    ggml_backend_dev_t device_ = nullptr;
+    ggml_backend_t backend_ = nullptr;
+    ggml_backend_buffer_type_t buffer_type_ = nullptr;
+    blink_worker::BackendMetadata metadata_;
+};
+
+inline void run_probe(Session & session) {
+    ggml_backend_buffer_t buffer = ggml_backend_buft_alloc_buffer(session.buffer_type(), 256);
+    if (!buffer) {
+        throw Error("backend_buffer_alloc_failed", "backend could not allocate a 256-byte probe buffer");
+    }
+    ggml_backend_buffer_free(buffer);
+
+    ggml_init_params params{ 16 * 1024, nullptr, true };
+    ggml_context * context = ggml_init(params);
+    if (!context) throw Error("backend_probe_context_failed", "failed to create probe graph context");
+    ggml_tensor * lhs = ggml_new_tensor_1d(context, GGML_TYPE_F32, 4);
+    ggml_tensor * rhs = ggml_new_tensor_1d(context, GGML_TYPE_F32, 4);
+    ggml_tensor * sum = ggml_add(context, lhs, rhs);
+    ggml_set_input(lhs);
+    ggml_set_input(rhs);
+    ggml_set_output(sum);
+    ggml_cgraph * graph = ggml_new_graph_custom(context, 32, false);
+    ggml_build_forward_expand(graph, sum);
+    ggml_gallocr_t allocator = nullptr;
+    try {
+        session.validate_graph(graph);
+        allocator = session.allocate_graph(graph);
+        const float a[4] = { 1, 2, 3, 4 };
+        const float b[4] = { 2, 3, 4, 5 };
+        session.set_input(lhs, a, sizeof(a));
+        session.set_input(rhs, b, sizeof(b));
+        session.compute(graph);
+        float result[4]{};
+        session.get_output(sum, result, sizeof(result));
+        for (int i = 0; i < 4; ++i) {
+            if (result[i] != a[i] + b[i]) {
+                throw Error("backend_probe_result_failed", "minimum graph returned an unexpected result");
+            }
+        }
+    } catch (...) {
+        if (allocator) ggml_gallocr_free(allocator);
+        ggml_free(context);
+        throw;
+    }
+    ggml_gallocr_free(allocator);
+    ggml_free(context);
+}
+
+inline int emit_probe_result(const CliOptions & options) {
+    try {
+        Session session(options);
+        run_probe(session);
+        const auto & info = session.metadata();
+        std::string line = "{\"type\":\"backend_probe\",\"protocol_version\":1,\"ok\":true";
+        line += ",\"requested_backend\":\"" + blink_worker::json_escape(info.requested_backend) + "\"";
+        line += ",\"actual_backend\":\"" + blink_worker::json_escape(info.actual_backend) + "\"";
+        line += ",\"device_name\":\"" + blink_worker::json_escape(info.device_name) + "\"";
+        line += ",\"device_id\":\"" + blink_worker::json_escape(info.device_id) + "\"";
+        line += ",\"buffer_type\":\"" + blink_worker::json_escape(info.buffer_type) + "\"";
+        line += ",\"graph\":{\"op\":\"add_f32\",\"status\":\"success\"}}\n";
+        fwrite(line.data(), 1, line.size(), stdout);
+        fflush(stdout);
+        return 0;
+    } catch (const Error & error) {
+        std::string line = "{\"type\":\"backend_probe\",\"protocol_version\":1,\"ok\":false";
+        line += ",\"requested_backend\":\"" + blink_worker::json_escape(options.requested_backend) + "\"";
+        line += ",\"error\":{\"code\":\"" + blink_worker::json_escape(error.code) + "\",\"message\":\"" +
+                blink_worker::json_escape(error.what()) + "\"}}\n";
+        fwrite(line.data(), 1, line.size(), stdout);
+        fflush(stdout);
+        return 2;
+    } catch (const std::exception & error) {
+        std::string line = "{\"type\":\"backend_probe\",\"protocol_version\":1,\"ok\":false";
+        line += ",\"requested_backend\":\"" + blink_worker::json_escape(options.requested_backend) + "\"";
+        line += ",\"error\":{\"code\":\"backend_probe_failed\",\"message\":\"" +
+                blink_worker::json_escape(error.what()) + "\"}}\n";
+        fwrite(line.data(), 1, line.size(), stdout);
+        fflush(stdout);
+        return 2;
+    }
+}
+
+inline int emit_startup_error(const CliOptions & options, const std::string & code,
+                              const std::string & message) {
+    std::string line = "{\"type\":\"error\",\"protocol_version\":1,\"request_id\":null";
+    line += ",\"requested_backend\":\"" + blink_worker::json_escape(options.requested_backend) + "\"";
+    line += ",\"error\":{\"code\":\"" + blink_worker::json_escape(code) + "\",\"message\":\"" +
+            blink_worker::json_escape(message) + "\"}}\n";
+    fwrite(line.data(), 1, line.size(), stdout);
+    fflush(stdout);
+    return 2;
+}
+
+}  // namespace blink_backend
+
+#endif  // BLINK_BACKEND_ADAPTER_H
