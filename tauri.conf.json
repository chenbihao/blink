{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blink",
  "version": "0.25.17",
  "identifier": "com.blink.launcher",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Blink",
        "width": 700,
        "height": 60,
        "minWidth": 700,
        "minHeight": 60,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "shadow": false,
        "backgroundColor": "#00000000",
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": ["plugins/builtin/**/*", "resources/bin/funasr-worker/**/*"],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/uninstall-cleanup.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyMzAzN0VCNUZGQTVBQTEKUldTaFd2cGY2emN3SWowREx4bHNFN2RTSG1QZ0Z1dUtnaE5PclRIUFMrNnVHTW8wTCsyTGdkL08K",
      "endpoints": [
        "https://github.com/chenbihao/blink/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
