{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blink",
  "version": "0.9.0",
  "identifier": "com.blink.launcher",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Blink",
        "width": 700,
        "height": 60,
        "minWidth": 700,
        "minHeight": 60,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "shadow": false,
        "backgroundColor": "#00000000",
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": ["plugins/builtin/**/*"]
  }
}
